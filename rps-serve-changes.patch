+class ExponentialMovingAverage:
+    def __init__(self, alpha, ema=None):
+        self.alpha = alpha
+        self.ema = self.curr = ema
+
+    def update(self, value):
+        self.curr = value
+        if self.ema is None:
+            self.ema = value
+        else:
+            self.ema = self.alpha * value + (1 - self.alpha) * self.ema
+
+    def clear(self):
+        self.ema = None
+
+
+class QueueManager:
+    cache = {
+        "llava-onevision-qwen2-0.5b-ov-hf": {
