diff --git a/src/guidellm/data/finalizers.py b/src/guidellm/data/finalizers.py
index 5fda041..b55e515 100644
--- a/src/guidellm/data/finalizers.py
+++ b/src/guidellm/data/finalizers.py
@@ -117,3 +117,12 @@ class GenerativeRequestFinalizer(DatasetFinalizer[Iterable[GenerationRequest]]):
             input_metrics=input_metrics,
             output_metrics=output_metrics,
         )
+
+@FinalizerRegistry.register("custom_generative")
+class CustomGenerativeFinalizer(GenerativeRequestFinalizer):
+    def finalize_turn(self, columns: dict[str, Any]) -> GenerationRequest:
+        rid = next(iter(columns.get("request_id", [])), None)
+        request = super().finalize_turn(columns)
+        if rid:
+            request.request_id = rid
+        return request
